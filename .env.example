# ============================================================================
# Lokale Entwicklungsumgebung (.env)
# ============================================================================
#
# WICHTIG: Diese Datei ist ein Template. Kopieren Sie diese als .env und
# füllen Sie die Werte mit echten Keys/Secrets.
#
# .env ist in .gitignore und wird NICHT committed!
#
# Für Netlify Production: Environment Variables in Netlify Site Settings setzen
# (nicht hier - diese lokale .env wird nicht hochgeladen)
#
# Aufbau:
#   1. GLOBAL           – gleich für alle Branches/Kunden (Agentur-Zugänge, Dev-Keys)
#   2. BRANCH-SPEZIFISCH – pro Kunden-Branch / Netlify-Site verschieden
#
# Die .env gilt für den ganzen Arbeitsordner, nicht pro Branch:
# Nach einem Branch-Wechsel Block 2 auf den Kunden des Branches anpassen
# (sonst z.B. Netlify Blobs / Admin-Login des falschen Kunden).


# ############################################################################
# 1. GLOBAL — für alle Branches gleich
# ############################################################################

# ----------------------------------------------------------------------------
# Netlify (Zugang)
# ----------------------------------------------------------------------------
# NETLIFY_TOKEN: Netlify → User Settings → Applications → Personal access tokens (Expiry: Never)
# Persönlicher Agentur-Token, gilt für alle Sites (Site-Wahl über NETLIFY_SITE_ID in Block 2)
NETLIFY_TOKEN=

# ----------------------------------------------------------------------------
# Agency Gating-Editor
# ----------------------------------------------------------------------------
# AGENCY_SECRET: Passwort für /agency/gating (Agentur-Zugang, Login-Formular)
AGENCY_SECRET=

# ----------------------------------------------------------------------------
# LLM / AI Services
# ----------------------------------------------------------------------------
# ANTHROPIC_API_KEY: Anthropic API-Key für den Chat-Assistenten dieser Anwendung
# Lokal nur einen separaten Development-Key verwenden; Produktions-Keys gehören
# ausschließlich in die Environment Variables der jeweiligen Netlify-Site.
# Nicht erforderlich für Claude Desktop oder GitHub Copilot in VS Code.
# Quelle und Rotation: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# ----------------------------------------------------------------------------
# Resend E-Mail Service (Zugang)
# ----------------------------------------------------------------------------
# RESEND_API_KEY: API-Key aus https://resend.com/api-keys
# Hat ein Kunde ein eigenes Resend-Konto, gehört der Key in Block 2.
RESEND_API_KEY=

# ----------------------------------------------------------------------------
# Nur für lokale Tests
# ----------------------------------------------------------------------------
# DATE_OVERRIDE: künstliches Datum (YYYY-MM-DD) für netlify/functions/send-reminders
DATE_OVERRIDE=


# ############################################################################
# 2. BRANCH-SPEZIFISCH — pro Kunde / Netlify-Site
# ############################################################################

# ----------------------------------------------------------------------------
# Netlify Site & Prismic-Repository
# ----------------------------------------------------------------------------
# NETLIFY_SITE_ID: Netlify → Site Settings → General → Site ID (Netlify Blobs: Buchungen, Kunden …)
NETLIFY_SITE_ID=
# PRISMIC_WRITE_TOKEN: Write-Token des Prismic-Repos dieses Kunden
PRISMIC_WRITE_TOKEN=

# ----------------------------------------------------------------------------
# Admin
# ----------------------------------------------------------------------------
# ADMIN_SECRET: Passwort für den Admin-Login unter /admin
# (Session-Cookie 8 h, mit „Angemeldet bleiben“ 14 Tage). Ändern → alle Sessions ungültig.
ADMIN_SECRET=
# NEWSLETTER_SECRET: optional, signiert die Abmelde-Links der Info-Mails (Fallback: ADMIN_SECRET).
# Achtung: Ändern macht alle bereits versendeten Abmelde-Links ungültig.
NEWSLETTER_SECRET=

# ----------------------------------------------------------------------------
# E-Mail Absender / Empfänger
# ----------------------------------------------------------------------------
# EMAIL_FROM_ADDRESS: Absender-Adresse (muss in Resend verifiziert sein)
# EMAIL_FROM_NAME: Absendername — erscheint in E-Mail-Clients statt der Adresse
# INVOICE_TO_EMAIL: optional, Geschäfts-E-Mail für Benachrichtigungen (Bestellungen, Buchungen, Formulare)
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=
INVOICE_TO_EMAIL=

# ----------------------------------------------------------------------------
# Chat-Assistent
# ----------------------------------------------------------------------------
# CHAT_SYSTEM_PROMPT: optional, ersetzt den Standard-System-Prompt des Chat-Bots
CHAT_SYSTEM_PROMPT=
# Kostendeckel Chat-Bot in USD (Standard 2 / 20, 0 = kein Deckel). Erreicht → «zurzeit nicht verfügbar»
CHAT_DAILY_BUDGET_USD=
CHAT_MONTHLY_BUDGET_USD=

# ----------------------------------------------------------------------------
# Ressourcen-Buchung (Türcodes)
# ----------------------------------------------------------------------------
# DOOR_CODE: Globaler Fallback-Türcode für Ressource-Buchungen
# DOOR_CODE_<RESSOURCE_UID>: optional, abweichender Türcode für eine einzelne Ressource
#   (UID uppercase, - → _), z.B. DOOR_CODE_CASA_CAMPELLI_OG=1234
DOOR_CODE=
