# ============================================================================
# Lokale Entwicklungsumgebung (.env)
# ============================================================================
#
# WICHTIG: Diese Datei ist ein Template. Kopieren Sie diese als .env und
# füllen Sie die Werte mit echten Keys/Secrets.
#
# .env ist in .gitignore und wird NICHT committed!
#
# Für Netlify Production: Environment Variables in Netlify Site Settings setzen
# (nicht hier - diese lokale .env wird nicht hochgeladen)

# ============================================================================
# Netlify Blobs (für Buchungen, Kundendaten etc.)
# ============================================================================
# NETLIFY_TOKEN:   Netlify → User Settings → Applications → Personal access tokens (Expiry: Never)
# NETLIFY_SITE_ID: Netlify → Site Settings → General → Site ID
NETLIFY_TOKEN=
NETLIFY_SITE_ID=

# ============================================================================
# Admin & Agency Secrets
# ============================================================================
# ADMIN_SECRET: Zugang zum Admin-Panel (/admin/dashboard?secret=...)
# AGENCY_SECRET: Zugang zum Gating-Editor (/agency/gating?secret=...)
#
# Lokal: Diese Secrets hier setzen
# Netlify: In Netlify Site Settings → Environment unter diesen Namen speichern
ADMIN_SECRET=
PRISMIC_WRITE_TOKEN=
# /agency/gating
AGENCY_SECRET=

# ============================================================================
# LLM / AI Services
# ============================================================================
# ANTHROPIC_API_KEY: Anthropic API-Key für den Chat-Assistenten dieser Anwendung
# Lokal nur einen separaten Development-Key verwenden; Produktions-Keys gehören
# ausschließlich in die Environment Variables der jeweiligen Netlify-Site.
# Nicht erforderlich für Claude Desktop oder GitHub Copilot in VS Code.
# Quelle und Rotation: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# CHAT_SYSTEM_PROMPT: System-Prompt für Claude Chat
CHAT_SYSTEM_PROMPT=

# ============================================================================
# Resend E-Mail Service
# ============================================================================
# RESEND_API_KEY: API-Key aus https://resend.com/api-keys
# EMAIL_FROM_ADDRESS: Absender-Adresse (muss in Resend verifiziert sein)
# EMAIL_FROM_NAME: Absendername — erscheint in E-Mail-Clients statt der Adresse
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=

# ============================================================================
# Sicherheit / Zugang
# ============================================================================
# DOOR_CODE: Globaler Fallback-Türcode für Ressource-Buchungen
# DOOR_CODE_<RESSOURCE_UID>: Ressource-spezifische Türcodes (UID uppercase, - → _)
DOOR_CODE=
DOOR_CODE_CASA_CAMPELLI_OG=