						"size-6xl",
						"weight-thin",
						"weight-light",
						"weight-medium",
						"weight-semibold",
						"weight-black",
						"tracking-tight",
						"tracking-wide",
						"tracking-wider",
						"tracking-widest",
						"leading-tight",
						"leading-loose",
						"uppercase",
						"lowercase",
						"capitalize",
						"underline",
						"block",
						"muted",
						"display-thin",
						"display-light",
						"display-bold",
						"display-black",
						"giant-thin",
						"giant-light",
						"giant-bold",
						"hero-thin",
						"hero-light",
						"hero-bold",
						"subtitle",
						"subtitle-bold",
						"kicker",
						"overline",
						"invisible"
					]
				}
			},
			"ticket_url": {
				"type": "Link",
				"config": {
					"label": "Tickets kaufen / Anmeldung",
					"allowTargetBlank": true,
					"placeholder": "https://..."
				}
			},
			"registration_required": {
				"type": "Boolean",
				"config": {
					"label": "Anmeldung erforderlich",
					"placeholder_true": "Ja",
					"placeholder_false": "Nein",
					"default_value": false
				}
			},
			"registration_deadline": {
				"type": "Date",
				"config": {
					"label": "Anmeldeschluss"
				}
			},
			"max_participants": {
				"type": "Number",
				"config": {
					"label": "Max. Teilnehmerzahl",
					"placeholder": "z.B. 30"
				}
			},
			"min_participants": {
				"type": "Number",
				"config": {
					"label": "Mindest-Teilnehmerzahl",
					"placeholder": "z.B. 5"
				}
			},
			"registration_email": {
				"type": "Text",
				"config": {
					"label": "Anmeldung per E-Mail",
					"placeholder": "z.B. anmeldung@beispiel.ch"
				}
			},
			"registration_whatsapp": {
				"type": "Text",
				"config": {
					"label": "Anmeldung per WhatsApp (Nummer)",
					"placeholder": "z.B. +41791234567"
				}
			},
			"registration_text_all": {
				"type": "Text",
				"config": {
					"label": "Anmeldetext (alle Termine)",
					"placeholder": "Hallo, ich möchte mich für alle Termine von {{Event-Name}} anmelden."
				}
			},
			"registration_text_single": {
				"type": "Text",
				"config": {
					"label": "Anmeldetext (Einzeltermin)",
					"placeholder": "Hallo, ich möchte mich für den Termin vom {{Datum}} von {{Event-Name}} anmelden."
				}
			},
			"registration_telegram": {
				"type": "Text",
				"config": {
					"label": "Anmeldung per Telegram (Username oder Nummer)",
					"placeholder": "@username oder +41..."
				}
			}
		},
		"Serie & Wiederholung": {
			"is_series": {
				"type": "Boolean",
				"config": {
					"label": "Veranstaltungsserie",
					"placeholder_true": "Ja, Teil einer Serie",
					"placeholder_false": "Nein, Einzelveranstaltung",
					"default_value": false
				}
			},
			"series_name": {
				"type": "Text",
				"config": {
					"label": "Serienname",
					"placeholder": "z.B. Montagsyoga, Mittagskonzerte 2026"
				}
			},
			"recurrence": {
				"type": "Select",
				"config": {
					"label": "Wiederholungsrhythmus",
					"placeholder": "Rhythmus wählen",
					"options": [
						"Einmalig",
						"Täglich",
						"Wöchentlich",
						"Zweiwöchentlich",
						"Monatlich",
						"Jährlich",
						"Unregelmässig"
					],
					"default_value": "Einmalig"
				}
			},
			"recurrence_days": {
				"type": "Text",
				"config": {
					"label": "Wochentag(e)",
					"placeholder": "z.B. Montag & Mittwoch"
				}
			},
			"series_end_date": {
				"type": "Date",
				"config": {
					"label": "Serienende (Datum)"
				}
			},
			"series_total_count": {
				"type": "Number",
				"config": {
					"label": "Anzahl Termine (Serie)",
					"placeholder": "z.B. 8"
				}
			},
			"series_exceptions": {
				"type": "Text",
				"config": {
					"label": "Ausnahmen / Ausfälle",
					"placeholder": "z.B. Kein Kurs am 1. August und 25. Dezember"
				}
			},
			"parent_event": {
				"type": "Link",
				"config": {
					"label": "Übergeordnetes Event / Serie",
					"allowTargetBlank": false,
					"placeholder": "Link zur Haupt-Veranstaltung"
				}
			},
			"individually_bookable": {
				"type": "Boolean",
				"config": {
					"label": "Einzeln buchbar",
					"placeholder_false": "Nein",
					"placeholder_true": "Ja",
					"default_value": false
				}
			},
			"individual_is_free": {
				"type": "Boolean",
				"config": {
					"label": "Einzeltermin kostenlos",
					"placeholder_false": "Nein",
					"placeholder_true": "Ja",
					"default_value": false
				}
			},
			"individual_price_text": {
				"type": "StructuredText",
				"config": {
					"label": "Einzeltermin Preis (Freitext)",
					"placeholder": "z.B. CHF 20 / Ermässigt CHF 15",
					"allowTargetBlank": true,
					"multi": "paragraph,strong,em,hyperlink,list-item,o-list-item",
