						"subtitle",
						"subtitle-bold",
						"kicker",
						"overline",
						"invisible"
					]
				}
			},
			"individual_registration_email": {
				"type": "Text",
				"config": {
					"label": "Einzeltermin Anmeldung per E-Mail",
					"placeholder": "z.B. anmeldung@beispiel.ch"
				}
			},
			"individual_registration_whatsapp": {
				"type": "Text",
				"config": {
					"label": "Einzeltermin Anmeldung per WhatsApp",
					"placeholder": "z.B. +41791234567"
				}
			},
			"individual_ticket_url": {
				"type": "Link",
				"config": {
					"label": "Einzeltermin Ticket-Link",
					"placeholder": "https://...",
					"allowTargetBlank": true
				}
			},
			"individual_registration_telegram": {
				"type": "Text",
				"config": {
					"label": "Einzeltermin Anmeldung per Telegram",
					"placeholder": "@username oder +41..."
				}
			}
		},
		"SEO": {
			"meta_title": {
				"type": "Text",
				"config": {
					"label": "SEO-Titel",
					"placeholder": "Titel für Suchmaschinen (max. 60 Zeichen)"
				}
			},
			"meta_description": {
				"type": "Text",
				"config": {
					"label": "SEO-Beschreibung",
					"placeholder": "Beschreibung für Suchmaschinen (max. 160 Zeichen)"
				}
			},
			"meta_image": {
				"type": "Image",
				"config": {
					"label": "SEO-Bild (Open Graph)",
					"constraint": {
						"width": 1200,
						"height": 630
					},
					"thumbnails": []
				}
			}
		}
	}
