{
	"id": "event",
	"label": "Event",
	"repeatable": true,
	"status": true,
	"format": "custom",
	"json": {
		"Allgemein": {
			"uid": {
				"type": "UID",
				"config": {
					"label": "UID",
					"placeholder": "z.B. yoga-workshop-april-2026"
				}
			},
			"title": {
				"type": "Text",
				"config": {
					"label": "Titel",
					"placeholder": "Name der Veranstaltung"
				}
			},
			"subtitle": {
				"type": "Text",
				"config": {
					"label": "Untertitel",
					"placeholder": "Optionaler Zusatztitel"
				}
			},
			"short_description": {
				"type": "StructuredText",
				"config": {
					"label": "Kurzbeschreibung",
					"placeholder": "Kurze Beschreibung für Vorschau und SEO",
					"allowTargetBlank": false,
					"multi": "paragraph,strong,em,hyperlink,list-item"
				}
			},
			"description": {
				"type": "StructuredText",
				"config": {
					"label": "Beschreibung",
					"allowTargetBlank": true,
					"multi": "paragraph,heading1,heading2,heading3,heading4,heading5,heading6,strong,em,hyperlink,image,embed,list-item,o-list-item,preformatted",
					"labels": [
						"highlight",
						"note",
						"quote",
						"size-xs",
						"size-sm",
						"size-lg",
						"size-xl",
						"size-2xl",
						"size-3xl",
						"size-4xl",
						"size-5xl",
						"size-6xl",
						"weight-thin",
						"weight-light",
						"weight-medium",
						"weight-semibold",
						"weight-black",
						"tracking-tight",
						"tracking-wide",
						"tracking-wider",
						"tracking-widest",
						"leading-tight",
						"leading-loose",
						"uppercase",
						"lowercase",
						"capitalize",
						"underline",
						"block",
						"muted",
						"display-thin",
						"display-light",
						"display-bold",
						"display-black",
						"giant-thin",
						"giant-light",
						"giant-bold",
						"hero-thin",
						"hero-light",
						"hero-bold",
						"subtitle",
						"subtitle-bold",
						"kicker",
						"overline",
						"invisible"
					]
				}
			},
			"image": {
				"type": "Image",
				"config": {
					"label": "Hauptbild",
					"constraint": {
						"width": 1600,
						"height": 900
					},
					"thumbnails": [
						{
							"name": "Quadratisch",
							"width": 800,
							"height": 800
						},
						{
							"name": "Portrait",
							"width": 800,
							"height": 1200
						}
					]
				}
			},
			"featured": {
				"type": "Boolean",
				"config": {
					"label": "Hervorgehoben",
					"placeholder_true": "Ja",
					"placeholder_false": "Nein",
					"default_value": false
				}
			},
			"status": {
				"type": "Select",
				"config": {
					"label": "Status",
					"placeholder": "Status wählen",
					"options": ["Kein", "Geplant", "Bestätigt", "Abgesagt", "Verschoben", "Ausgebucht"],
					"default_value": "Geplant"
				}
			},
			"slices": {
				"type": "Slices",
				"fieldset": "Inhalt",
				"config": {
					"choices": {}
				}
			}
		},
		"Datum & Zeit": {
			"start_date": {
				"type": "Timestamp",
				"config": {
					"label": "Beginn (Datum & Uhrzeit)",
					"placeholder": "Startdatum und -uhrzeit"
				}
			},
			"end_date": {
				"type": "Timestamp",
				"config": {
					"label": "Ende (Datum & Uhrzeit)",
					"placeholder": "Enddatum und -uhrzeit"
				}
			},
			"doors_open": {
				"type": "Text",
				"config": {
					"label": "Einlass ab",
					"placeholder": "z.B. 18:30 Uhr"
				}
			},
			"timezone": {
				"type": "Select",
				"config": {
					"label": "Zeitzone",
					"placeholder": "Zeitzone wählen",
					"options": ["Europe/Zurich", "Europe/Berlin", "Europe/Vienna", "UTC"],
					"default_value": "Europe/Zurich"
				}
			}
		},
		"Ort": {
			"online_event": {
				"type": "Boolean",
				"config": {
					"label": "Online-Veranstaltung",
					"placeholder_true": "Ja",
					"placeholder_false": "Nein",
					"default_value": false
				}
			},
			"online_url": {
				"type": "Link",
				"config": {
					"label": "Online-Link / Stream",
					"allowTargetBlank": true,
					"placeholder": "https://..."
				}
			},
			"location_name": {
				"type": "Text",
				"config": {
					"label": "Veranstaltungsort / Bezeichnung",
					"placeholder": "z.B. Stadthalle, Café XY, Studio 4"
				}
			},
			"location_room": {
				"type": "Text",
				"config": {
					"label": "Raum / Saal",
					"placeholder": "z.B. Saal A, Erdgeschoss"
				}
			},
			"location_address": {
				"type": "Text",
				"config": {
					"label": "Strasse & Hausnummer",
					"placeholder": "z.B. Musterstrasse 12"
				}
			},
			"location_zip": {
				"type": "Text",
				"config": {
					"label": "PLZ",
					"placeholder": "z.B. 8001"
				}
			},
			"location_city": {
				"type": "Text",
				"config": {
					"label": "Ort",
					"placeholder": "z.B. Zürich"
				}
			},
			"location_country": {
				"type": "Select",
				"config": {
					"label": "Land",
					"placeholder": "Land wählen",
					"options": ["Schweiz", "Deutschland", "Österreich", "Liechtenstein", "Sonstiges"],
					"default_value": "Schweiz"
				}
			},
			"location_map_url": {
				"type": "Text",
				"config": {
					"label": "Karte / Google Maps",
					"placeholder": "https://maps.google.com/..."
				}
			},
			"map_height": {
				"type": "Number",
				"config": {
					"label": "Kartenhöhe (px)",
					"placeholder": "400"
				}
			},
			"opacity": {
				"type": "Number",
				"config": {
					"label": "Transparenz",
					"placeholder": "Zahl zwischen 0 und 80 %"
				}
			},
			"mobile_full_width": {
				"type": "Boolean",
				"config": {
					"label": "Vollbreite auf Mobile",
					"placeholder_false": "Nein",
					"placeholder_true": "Ja",
					"default_value": false
				}
			},
			"website": {
				"type": "Link",
				"config": {
					"label": "Website",
					"allowTargetBlank": true
				}
			},
			"directions": {
				"type": "StructuredText",
				"config": {
					"label": "Wegbeschreibung",
					"allowTargetBlank": true,
					"multi": "paragraph,heading1,heading2,heading3,heading4,heading5,heading6,strong,em,hyperlink,image,embed,list-item,o-list-item,preformatted",
					"labels": [
						"highlight",
						"note",
						"quote",
						"size-xs",
						"size-sm",
						"size-lg",
						"size-xl",
						"size-2xl",
						"size-3xl",
						"size-4xl",
						"size-5xl",
						"size-6xl",
						"weight-thin",
						"weight-light",
						"weight-medium",
						"weight-semibold",
						"weight-black",
						"tracking-tight",
						"tracking-wide",
						"tracking-wider",
						"tracking-widest",
						"leading-tight",
						"leading-loose",
						"uppercase",
						"lowercase",
						"capitalize",
						"underline",
						"block",
						"muted",
						"display-thin",
						"display-light",
						"display-bold",
						"display-black",
						"giant-thin",
						"giant-light",
						"giant-bold",
						"hero-thin",
						"hero-light",
						"hero-bold",
						"subtitle",
						"subtitle-bold",
						"kicker",
						"overline",
						"invisible"
					]
				}
			}
		},
		"Details": {
			"event_type": {
				"type": "Select",
				"config": {
					"label": "Veranstaltungsart",
					"placeholder": "Art wählen",
					"options": [
						"Ausstellung",
						"Festival",
						"Führung",
						"Jubiläum",
						"Konzert",
						"Kurs",
						"Lesung",
						"Messe",
						"Party / Fest",
						"Seminar",
						"Sportveranstaltung",
						"Tag der offenen Tür",
						"Vortrag",
						"Workshop",
						"Sonstiges"
					]
				}
			},
			"event_language": {
				"type": "Select",
				"config": {
					"label": "Sprache der Veranstaltung",
					"placeholder": "Sprache wählen",
					"options": [
						"Deutsch",
						"Englisch",
						"Französisch",
						"Italienisch",
						"Mehrsprachig",
						"Keine Sprache"
					],
					"default_value": "Deutsch"
				}
			},
			"target_audience": {
				"type": "Text",
				"config": {
					"label": "Zielgruppe",
					"placeholder": "z.B. Erwachsene ab 18, Familien mit Kindern"
				}
			},
			"min_age": {
				"type": "Number",
				"config": {
					"label": "Mindestalter",
					"placeholder": "z.B. 16"
				}
			},
			"organizer": {
				"type": "Text",
				"config": {
					"label": "Veranstalter",
					"placeholder": "Name der veranstaltenden Organisation"
				}
			},
			"organizer_url": {
				"type": "Link",
				"config": {
					"label": "Veranstalter-Website",
					"allowTargetBlank": true,
					"placeholder": "https://..."
				}
			},
			"contact_email": {
				"type": "Text",
				"config": {
					"label": "Kontakt E-Mail",
					"placeholder": "info@beispiel.ch"
				}
			},
			"contact_phone": {
				"type": "Text",
				"config": {
					"label": "Kontakt Telefon",
					"placeholder": "+41 44 123 45 67"
				}
			},
			"accessibility_info": {
				"type": "Text",
				"config": {
					"label": "Barrierefreiheit",
					"placeholder": "z.B. Rollstuhlzugang, Induktionsschleife"
				}
			},
			"additional_info": {
				"type": "StructuredText",
				"config": {
					"label": "Weitere Hinweise",
					"placeholder": "Parkplätze, Kleidungsvorschriften, Mitbringen usw.",
					"allowTargetBlank": false,
					"multi": "paragraph,strong,em,list-item"
				}
			}
		},
		"Tickets & Anmeldung": {
			"is_free": {
				"type": "Boolean",
				"config": {
					"label": "Kostenlos",
					"placeholder_true": "Ja",
					"placeholder_false": "Nein",
					"default_value": false
				}
			},
			"price_text": {
				"type": "StructuredText",
				"config": {
					"label": "Preis (Freitext)",
					"placeholder": "z.B. CHF 20 / Ermässigt CHF 15 / Kinder frei",
					"allowTargetBlank": true,
					"multi": "paragraph,strong,em,hyperlink,list-item,o-list-item",
					"labels": [
						"highlight",
						"note",
						"quote",
						"size-xs",
						"size-sm",
						"size-lg",
						"size-xl",
						"size-2xl",
