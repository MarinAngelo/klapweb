{
	"id": "aufgabe",
	"label": "Aufgabe",
	"format": "custom",
	"repeatable": true,
	"status": true,
	"json": {
		"Main": {
			"uid": {
				"type": "UID",
				"config": {
					"label": "UID",
					"placeholder": "z.B. rasen-maehen"
				}
			},
			"titel": {
				"type": "Text",
				"config": {
					"label": "Titel",
					"placeholder": "z.B. Rasen mähen"
				}
			},
			"beschreibung": {
				"type": "StructuredText",
				"config": {
					"label": "Beschreibung",
					"allowTargetBlank": true,
					"multi": "paragraph,strong,em,hyperlink,list-item"
				}
			},
			"bild": {
				"type": "Image",
				"config": {
					"label": "Bild",
					"constraint": {},
					"thumbnails": []
				}
			},
			"aktiv": {
				"type": "Boolean",
				"config": {
					"label": "Aktiv",
					"default_value": true
				}
			},
			"priority": {
				"type": "Select",
				"config": {
					"label": "Priorität (Teilaufgaben übernehmen die Priorität der Hauptaufgabe)",
					"options": ["Hoch", "Mittel", "Gering"],
					"default_value": "Mittel"
				}
			},
			"max_annahmen": {
				"type": "Number",
				"config": {
					"label": "Max. Annahmen (0 = unbegrenzt)",
					"placeholder": "0"
				}
			},
			"credit_typ": {
				"type": "Select",
				"config": {
					"label": "Credit-Typ",
					"options": ["Fest", "Offen (Zeitbasiert)"],
					"default_value": "Fest"
				}
			},
			"credit_betrag": {
				"type": "Number",
				"config": {
					"label": "Credits (nur bei Fest)",
					"placeholder": "z.B. 10"
				}
			}
		},
		"Teilaufgaben": {
			"parent_task": {
				"type": "Link",
				"config": {
					"label": "Hauptaufgabe (nur bei Teilaufgaben ausfüllen)",
					"placeholder": "Diese Aufgabe ist ein Teil von …",
					"customtypes": ["aufgabe"],
					"allowText": false
				}
			},
			"position": {
				"type": "Number",
				"config": {
					"label": "Position innerhalb der Hauptaufgabe (nur bei Teilaufgaben)",
					"placeholder": "z.B. 1"
				}
			},
			"enforce_order": {
				"type": "Boolean",
				"config": {
					"label": "Teilaufgaben in Reihenfolge erzwingen (nur bei Hauptaufgabe)",
					"default_value": false
				}
			},
			"bonus_credits": {
				"type": "Number",
				"config": {
					"label": "Bonus-Credits, wenn alle Teilaufgaben erledigt sind (nur bei Hauptaufgabe)",
					"placeholder": "z.B. 20"
				}
			}
		},
		"Werkzeuge": {
			"werkzeuge": {
				"type": "Group",
				"config": {
					"label": "Werkzeuge",
					"repeat": true,
					"fields": {
						"werkzeug": {
							"type": "Link",
							"config": {
								"label": "Werkzeug",
								"select": "document",
								"customtypes": ["werkzeug"],
								"allowText": false
							}
						}
					}
				}
			}
		}
	}
}
