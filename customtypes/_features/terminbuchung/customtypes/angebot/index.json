{
	"id": "angebot",
	"label": "Buchbares Angebot",
	"format": "custom",
	"repeatable": true,
	"status": true,
	"json": {
		"Main": {
			"uid": {
				"type": "UID",
				"config": { "label": "UID", "placeholder": "" }
			},
			"titel": {
				"type": "Text",
				"config": { "label": "Bezeichnung", "placeholder": "z.B. Massage 60 Minuten" }
			},
			"beschreibung": {
				"type": "StructuredText",
				"config": {
					"label": "Beschreibung",
					"allowTargetBlank": true,
					"multi": "paragraph,strong,em,hyperlink,list-item,o-list-item"
				}
			},
			"dauer": {
				"type": "Number",
				"config": { "label": "Dauer (Minuten)", "placeholder": "60" }
			},
			"puffer_danach": {
				"type": "Number",
				"config": { "label": "Puffer danach (Minuten)", "placeholder": "0" }
			},
			"vorlaufzeit": {
				"type": "Number",
				"config": {
					"label": "Vorlaufzeit (Minuten)",
					"placeholder": "0 = bis Terminbeginn buchbar"
				}
			},
			"preis": {
				"type": "Number",
				"config": { "label": "Preis (optional)", "placeholder": "" }
			},
			"cancel_free_hours": {
				"type": "Number",
				"config": {
					"label": "Kostenlos stornierbar bis (Std. vor Termin)",
					"placeholder": "leer = Standard aus den Einstellungen"
				}
			},
			"cancel_fee_percent": {
				"type": "Number",
				"config": {
					"label": "Stornogebühr nach Ablauf (% vom Preis)",
					"placeholder": "z.B. 80 — leer = Standard aus den Einstellungen"
				}
			},
			"ort": {
				"type": "Link",
				"config": {
					"label": "Ort",
					"select": "document",
					"customtypes": ["ort"]
				}
			},
			"bild": {
				"type": "Image",
				"config": {
					"label": "Bild (für Kacheln)",
					"constraint": { "width": 2200, "height": 1200 },
					"thumbnails": []
				}
			},
			"info_page": {
				"type": "Link",
				"config": {
					"label": "Seite mit mehr Infos",
					"placeholder": "",
					"allowTargetBlank": true,
					"customtypes": ["page"]
				}
			},
			"sort_order": {
				"type": "Number",
				"config": {
					"label": "Reihenfolge (Kacheln)",
					"placeholder": "1 = zuerst, leer = am Schluss"
				}
			},
			"aktiv": {
				"type": "Boolean",
				"config": {
					"label": "Aktiv",
					"placeholder_false": "Nein",
					"placeholder_true": "Ja",
					"default_value": true
				}
			}
		}
	}
}
