{
	"id": "terminplanung",
	"label": "Terminplanung",
	"format": "custom",
	"repeatable": true,
	"status": true,
	"json": {
		"Main": {
			"uid": {
				"type": "UID",
				"config": {
					"label": "UID",
					"placeholder": ""
				}
			},
			"titel": {
				"type": "Text",
				"config": {
					"label": "Bezeichnung",
					"placeholder": "z.B. Erstgespräch"
				}
			},
			"datum": {
				"type": "Date",
				"config": {
					"label": "Datum"
				}
			},
			"uhrzeit": {
				"type": "Text",
				"config": {
					"label": "Uhrzeit (HH:MM)",
					"placeholder": "14:00"
				}
			},
			"session_laenge": {
				"type": "Number",
				"config": {
					"label": "Dauer (Minuten)",
					"placeholder": "60"
				}
			},
			"zeitzone": {
				"type": "Select",
				"config": {
					"label": "Zeitzone",
					"options": [
						"Europe/Zurich",
						"Europe/Berlin",
						"Europe/Vienna",
						"Europe/London",
						"America/New_York",
						"America/Los_Angeles",
						"Asia/Tokyo"
					],
					"default_value": "Europe/Zurich"
				}
			}
		}
	}
}
