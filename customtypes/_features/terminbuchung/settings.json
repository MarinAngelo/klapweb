{
	"_meta": {
		"insertBefore": null
	},
	"Terminbuchung": {
		"booking_customer_email_subject": {
			"type": "Text",
			"config": {
				"label": "Kunden-E-Mail: Betreff",
				"placeholder": "Tokens: {{Titel}} {{Datum}} {{Uhrzeit}} {{Dauer}} {{Name}} {{Firma}}"
			}
		},
		"booking_customer_email_body": {
			"type": "StructuredText",
			"config": {
				"label": "Kunden-E-Mail: Text",
				"placeholder": "Tokens: {{Titel}} {{Datum}} {{Uhrzeit}} {{Dauer}} {{Name}} {{Firma}}",
				"allowTargetBlank": false,
				"multi": "paragraph,strong,em,list-item,o-list-item"
			}
		},
		"booking_success_title": {
			"type": "Text",
			"config": {
				"label": "Buchungsbestätigung: Titel",
				"placeholder": "Termin gebucht"
			}
		},
		"booking_reminder_hours": {
			"type": "Number",
			"config": {
				"label": "Erinnerung: Stunden vor Termin",
				"placeholder": "24 (leer = keine Erinnerung)"
			}
		},
		"booking_invoice": {
			"type": "Boolean",
			"config": {
				"label": "Rechnung nach dem Termin senden (Angebote mit Preis)",
				"placeholder_false": "Nein",
				"placeholder_true": "Ja",
				"default_value": false
			}
		},
		"booking_cancel_free_hours": {
			"type": "Number",
			"config": {
				"label": "Kostenlos stornierbar bis (Std. vor Termin)",
				"placeholder": "leer = jederzeit kostenlos stornierbar"
			}
		},
		"booking_cancel_fee_percent": {
			"type": "Number",
			"config": {
				"label": "Stornogebühr nach Ablauf (% vom Preis)",
				"placeholder": "z.B. 80 — leer = danach keine Online-Stornierung"
			}
		}
	}
}
