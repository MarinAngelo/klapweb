{
	"id": "ort",
	"label": "Ort / Standort",
	"format": "custom",
	"repeatable": true,
	"status": true,
	"json": {
		"Main": {
			"uid": {
				"type": "UID",
				"config": {
					"label": "UID",
					"placeholder": "z.B. zuerich-city"
				}
			},
			"name": {
				"type": "Text",
				"config": {
					"label": "Name",
					"placeholder": "z.B. Zürich City"
				}
			},
			"adresse": {
				"type": "StructuredText",
				"config": {
					"label": "Adresse",
					"allowTargetBlank": true,
					"multi": "paragraph,strong,em,hyperlink,list-item,o-list-item"
				}
			},
			"geo_koordinaten": {
				"type": "Text",
				"config": {
					"label": "Geo-Koordinaten",
					"placeholder": "z.B. 47.3769, 8.5417 (aus Google Maps kopieren)"
				}
			},
			"wegbeschreibung": {
				"type": "StructuredText",
				"config": {
					"label": "Wegbeschreibung",
					"allowTargetBlank": true,
					"multi": "paragraph,strong,em,hyperlink,list-item,o-list-item"
				}
			},
			"telefon": {
				"type": "Text",
				"config": {
					"label": "Telefon",
					"placeholder": "+41 ..."
				}
			},
			"email": {
				"type": "Text",
				"config": {
					"label": "E-Mail",
					"placeholder": "ort@beispiel.ch"
				}
			},
			"oeffnungszeiten": {
				"type": "StructuredText",
				"config": {
					"label": "Öffnungszeiten",
					"allowTargetBlank": true,
					"multi": "paragraph,strong,em,list-item,o-list-item"
				}
			},
			"bild": {
				"type": "Image",
				"config": {
					"label": "Bild"
				}
			},
			"aktiv": {
				"type": "Boolean",
				"config": {
					"label": "Aktiv",
					"placeholder_false": "Nein",
					"placeholder_true": "Ja",
					"default_value": true
				}
			}
		}
	}
}
