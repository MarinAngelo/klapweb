{
	"id": "aufgabe",
	"label": "Aufgabe",
	"format": "custom",
	"repeatable": true,
	"status": true,
	"json": {
		"Main": {
			"uid": {
				"type": "UID",
				"config": {
					"label": "UID",
					"placeholder": "z.B. rasen-maehen"
				}
			},
			"titel": {
				"type": "Text",
				"config": {
					"label": "Titel",
					"placeholder": "z.B. Rasen mähen"
				}
			},
			"beschreibung": {
				"type": "StructuredText",
				"config": {
					"label": "Beschreibung",
					"allowTargetBlank": true,
					"multi": "paragraph,strong,em,hyperlink,list-item"
				}
			},
			"bild": {
				"type": "Image",
				"config": {
					"label": "Bild",
					"constraint": {},
					"thumbnails": []
				}
			},
			"aktiv": {
				"type": "Boolean",
				"config": {
					"label": "Aktiv",
					"default_value": true
				}
			},
			"max_annahmen": {
				"type": "Number",
				"config": {
					"label": "Max. Annahmen (0 = unbegrenzt)",
					"placeholder": "0"
				}
			}
		},
		"Werkzeuge": {
			"werkzeuge": {
				"type": "Group",
				"config": {
					"label": "Werkzeuge",
					"repeat": true,
					"fields": {
						"werkzeug": {
							"type": "Link",
							"config": {
								"label": "Werkzeug",
								"select": "document",
								"customtypes": [
									"werkzeug"
								],
								"allowText": false
							}
						}
					}
				}
			}
		},
		"Credits": {
			"credit_typ": {
				"type": "Select",
				"config": {
					"label": "Credit-Typ",
					"options": [
						"Fest",
						"Offen (Zeitbasiert)"
					],
					"default_value": "Fest"
				}
			},
			"credit_betrag": {
				"type": "Number",
				"config": {
					"label": "Credits (nur bei Fest)",
					"placeholder": "z.B. 10"
				}
			}
		}
	}
}
