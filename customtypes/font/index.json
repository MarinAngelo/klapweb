{
	"format": "custom",
	"id": "font",
	"label": "Schrift",
	"repeatable": true,
	"status": true,
	"json": {
		"Main": {
			"name": {
				"type": "Text",
				"config": {
					"label": "Name",
					"placeholder": ""
				}
			},
			"uid": {
				"type": "UID",
				"config": {
					"label": "UID",
					"placeholder": "gleich wie Name"
				}
			},
			"provider": {
				"type": "Select",
				"config": {
					"label": "Anbieter",
					"placeholder": "",
					"options": ["Google", "Adobe", "Lokal"],
					"default_value": "Google"
				}
			},
			"variants": {
				"type": "Text",
				"config": {
					"label": "Varianten (Google)",
					"placeholder": "z.B. \"ital,wght@0,100..900;1,100..900\""
				}
			}
		}
	}
}
