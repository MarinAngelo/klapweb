{
	"format": "custom",
	"id": "font",
	"label": "Schrift",
	"repeatable": true,
	"status": true,
	"json": {
		"Main": {
			"name": {
				"type": "Text",
				"config": {
					"label": "Name",
					"placeholder": ""
				}
			},
			"uid": {
				"type": "UID",
				"config": {
					"label": "UID",
					"placeholder": "gleich wie Name"
				}
			},
			"provider": {
				"type": "Select",
				"config": {
					"label": "Anbieter",
					"placeholder": "",
					"options": ["Google", "Lokal"],
					"default_value": "Google"
				}
			},
			"variants": {
				"type": "Text",
				"config": {
					"label": "Varianten (Google)",
					"placeholder": "z.B. \"ital,wght@0,100..900;1,100..900\""
				}
			},
			"files": {
				"type": "Group",
				"config": {
					"label": "Schriftdateien (Lokal)",
					"repeat": true,
					"fields": {
						"file": {
							"type": "Link",
							"config": {
								"label": "Datei (.woff2, .woff, .ttf, .otf)",
								"select": "media",
								"placeholder": "Datei aus der Mediathek"
							}
						},
						"weight": {
							"type": "Select",
							"config": {
								"label": "Gewicht",
								"placeholder": "",
								"options": ["100", "200", "300", "400", "500", "600", "700", "800", "900"],
								"default_value": "400"
							}
						},
						"style": {
							"type": "Select",
							"config": {
								"label": "Stil",
								"placeholder": "",
								"options": ["normal", "kursiv"],
								"default_value": "normal"
							}
						}
					}
				}
			}
		}
	}
}
