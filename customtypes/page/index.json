{
	"id": "page",
	"label": "Page",
	"format": "page",
	"repeatable": true,
	"status": true,
	"json": {
		"Main": {
			"uid": {
				"type": "UID",
				"config": {
					"label": "UID",
					"placeholder": ""
				}
			},
			"title": {
				"type": "StructuredText",
				"config": {
					"label": "Seitentitel",
					"placeholder": "",
					"allowTargetBlank": true,
					"single": "heading1"
				}
			},
			"slices": {
				"type": "Slices",
				"fieldset": "Slice Zone",
				"config": {
					"choices": {
						"p5_grafik": {
						"preisvergleich": {
							"type": "SharedSlice"
						},
						"text_and_cta": {
							"type": "SharedSlice"
						},
						"button": {
							"type": "SharedSlice"
						},
						"anleitung": {
							"type": "SharedSlice"
						},
						"globale_events": {
							"type": "SharedSlice"
						},
						"event": {
							"type": "SharedSlice"
						},
						"html_code": {
							"type": "SharedSlice"
						},
						"code_einbetten": {
							"type": "SharedSlice"
						},
						"accordion": {
							"type": "SharedSlice"
						},
						"form": {
							"type": "SharedSlice"
						},
						"hero": {
							"type": "SharedSlice"
						},
						"quote": {
							"type": "SharedSlice"
						},
						"text": {
							"type": "SharedSlice"
						},
						"image": {
							"type": "SharedSlice"
						},
						"image_cards": {
							"type": "SharedSlice"
						},
						"text_with_image": {
							"type": "SharedSlice"
						},
						"preisaufstellung": {
							"type": "SharedSlice"
						}
					}
				}
			}
		},
		"E-Commerce": {
			"ecommerce_active": {
				"type": "Boolean",
				"config": {
					"label": "E-Commerce aktiv",
					"placeholder_false": "Nein",
					"placeholder_true": "Ja",
					"default_value": false
				}
			},
			"ecommerce_price_chf": {
				"type": "Number",
				"config": {
					"label": "Preis exkl. MwSt. (CHF)",
					"placeholder": "1290"
				}
			},
			"ecommerce_deposit_percent": {
				"type": "Number",
				"config": {
					"label": "Anzahlung %",
					"placeholder": "30"
				}
			},
			"ecommerce_discount_percent": {
				"type": "Number",
				"config": {
					"label": "Rabatt %",
					"placeholder": "10"
				}
			},
			"ecommerce_billing_type": {
				"type": "Select",
				"config": {
					"label": "Abrechnungsart",
					"options": ["Einmalig", "Jährlich", "Monatlich"],
					"default_value": "Einmalig"
				}
			},
			"ecommerce_addons": {
				"type": "Group",
				"config": {
					"label": "Zusatzleistungen",
					"fields": {
						"addon_page": {
							"type": "Link",
							"config": {
								"label": "Seite",
								"select": "document",
								"customtypes": ["page"]
							}
						}
					}
				}
			},
			"ecommerce_stripe_url": {
				"type": "Link",
				"config": {
					"label": "Stripe Payment Link",
					"placeholder": "https://buy.stripe.com/...",
					"select": null,
					"allowTargetBlank": true
				}
			},
			"leistungen": {
				"type": "Group",
				"config": {
					"label": "Leistungen",
					"fields": {
						"leistung": {
							"type": "Link",
							"config": {
								"label": "Leistung",
								"select": "document",
								"customtypes": ["leistung"]
							}
						},
						"wert": {
							"type": "Text",
							"config": {
								"label": "Wert (optional)",
								"placeholder": "✓ oder bis 5 Produkte"
							}
						}
					}
				}
			}
		},
		"SEO & Metadata": {
			"meta_title": {
				"type": "Text",
				"config": {
					"label": "Meta Titel",
					"placeholder": "Ein Seitentitel, der für soziale Medien und Suchmaschinen verwendet wird"
				}
			},
			"meta_description": {
				"type": "Text",
				"config": {
					"label": "Meta Description",
					"placeholder": "Eine kurze Zusammenfassung der Seite, 150–160 Zeichen (inkl. Leerzeichen)"
				}
			},
			"meta_image": {
				"type": "Image",
				"config": {
					"label": "Meta Image",
					"constraint": {
						"width": 2400,
						"height": 1260
					},
					"thumbnails": []
				}
			},
			"no_index": {
				"type": "Boolean",
				"config": {
					"label": "Keine Indexierung",
					"placeholder_false": "Nein ",
					"placeholder_true": "Ja",
					"default_value": false
				}
			},
			"landing_page": {
				"type": "Boolean",
				"config": {
					"label": "Landing Page",
					"placeholder_false": "Nein",
					"placeholder_true": "Ja",
					"default_value": false
				}
			}
		}
	}
}
