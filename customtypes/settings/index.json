{
	"id": "settings",
	"label": "Einstellungen",
	"format": "custom",
	"repeatable": false,
	"status": true,
	"json": {
		"Main": {
			"site_title": {
				"type": "StructuredText",
				"config": {
					"label": "Website Titel",
					"placeholder": "Title of the site",
					"allowTargetBlank": false,
					"single": "heading1"
				}
			},
			"site_sub_title": {
				"type": "StructuredText",
				"config": {
					"label": "Website Untertitel",
					"placeholder": "",
					"allowTargetBlank": false,
					"single": "heading2"
				}
			},
			"responsible_person_company": {
				"type": "Text",
				"config": {
					"label": "Verantwortlich (Person/Unternehmen)",
					"placeholder": ""
				}
			},
			"responsible_address": {
				"type": "StructuredText",
				"config": {
					"label": "Verantwortliche Adresse",
					"placeholder": "",
					"allowTargetBlank": false,
					"multi": "paragraph"
				}
			},
			"responsible_email": {
				"type": "Text",
				"config": {
					"label": "Verantwortliche E-Mail",
					"placeholder": ""
				}
			},
			"e_mail": {
				"type": "Text",
				"config": {
					"label": "Korrespondenz E-Mail",
					"placeholder": ""
				}
			},
			"privacy_policy": {
				"type": "StructuredText",
				"config": {
					"label": "Datenschutzerkärung",
					"placeholder": "",
					"allowTargetBlank": true,
					"multi": "paragraph,heading2,heading3,heading4,heading5,heading6,strong,em,hyperlink,image,list-item,o-list-item,rtl"
				}
			},
			"legal_disclosure": {
				"type": "StructuredText",
				"config": {
					"label": "Impressum",
					"placeholder": "",
					"allowTargetBlank": true,
					"multi": "paragraph,heading2,heading3,heading4,heading5,heading6,strong,em,hyperlink,image,list-item,o-list-item,rtl"
				}
			},
			"contacts": {
				"type": "Group",
				"config": {
					"label": "Kontakte",
					"repeat": true,
					"fields": {
						"impressum": {
							"type": "Boolean",
							"config": {
								"label": "Impressum",
								"placeholder_false": "Nein",
								"placeholder_true": "Ja",
								"default_value": true
							}
						},
						"title": {
							"type": "Text",
							"config": {
								"label": "Titel / Funktion",
								"placeholder": "z. B. Design"
							}
						},
						"name": {
							"type": "Text",
							"config": {
								"label": "Name",
								"placeholder": ""
							}
						},
						"email": {
							"type": "Text",
							"config": {
								"label": "E-Mail",
								"placeholder": ""
							}
						},
						"website": {
							"type": "Link",
							"config": {
								"label": "Website",
								"placeholder": "",
								"select": null,
								"allowTargetBlank": true,
								"allowText": true,
								"repeat": false
							}
						},
						"address": {
							"type": "StructuredText",
							"config": {
								"label": "Adresse",
								"placeholder": "",
								"allowTargetBlank": false,
								"multi": "paragraph"
							}
						}
					}
				}
			}
		}
	}
}
