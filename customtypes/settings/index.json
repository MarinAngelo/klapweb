{
	"id": "settings",
	"label": "Einstellungen",
	"format": "custom",
	"repeatable": false,
	"status": true,
	"json": {
		"Main": {
			"site_title": {
				"type": "StructuredText",
				"config": {
					"label": "Website Titel",
					"placeholder": "Title of the site",
					"allowTargetBlank": false,
					"single": "heading1"
				}
			},
			"site_sub_title": {
				"type": "StructuredText",
				"config": {
					"label": "Website Untertitel",
					"placeholder": "",
					"allowTargetBlank": false,
					"single": "heading2"
				}
			},
			"responsible_person_company": {
				"type": "Text",
				"config": {
					"label": "Verantwortlich (Person/Unternehmen)",
					"placeholder": ""
				}
			},
			"responsible_address": {
				"type": "StructuredText",
				"config": {
					"label": "Verantwortliche Adresse",
					"placeholder": "",
					"allowTargetBlank": false,
					"multi": "paragraph"
				}
			},
			"responsible_email": {
				"type": "Text",
				"config": {
					"label": "Verantwortliche E-Mail",
					"placeholder": ""
				}
			},
			"e_mail": {
				"type": "Text",
				"config": {
					"label": "E-Mail",
					"placeholder": ""
				}
			},
			"privacy_policy": {
				"type": "StructuredText",
				"config": {
					"label": "Datenschutzerkärung",
					"placeholder": "",
					"allowTargetBlank": true,
					"multi": "paragraph,heading2,heading3,heading4,heading5,heading6,strong,em,hyperlink,image,list-item,o-list-item,rtl"
				}
			}
		}
	}
}
