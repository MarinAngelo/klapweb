{
	"format": "custom",
	"id": "theme",
	"label": "Design Vorlage",
	"repeatable": true,
	"status": true,
	"json": {
		"Generell": {
			"theme_name": {
				"type": "Text",
				"config": {
					"label": "Design Vorlage Bezeichnung",
					"placeholder": ""
				}
			},
			"uid": {
				"type": "UID",
				"config": {
					"label": "UID"
				}
			},
			"page_color": {
				"type": "Color",
				"config": {
					"label": "Textfarbe",
					"placeholder": "Hex-Farbcode (#RRGGBB)"
				}
			},
			"page_bg_color": {
				"type": "Color",
				"config": {
					"label": "Hintergrundfarbe",
					"placeholder": "Hex-Farbcode (#RRGGBB)"
				}
			},
			"page_font": {
				"type": "Link",
				"config": {
					"label": "Hauptschrift",
					"select": "document",
					"repeat": false,
					"customtypes": [
						{
							"id": "font",
							"fields": ["name"]
						}
					]
				}
			},
			"base_font_size_mobile": {
				"type": "Select",
				"config": {
					"label": "Mobile Basis-Schriftgrösse",
					"placeholder": "",
					"options": ["Sehr Klein", "Klein", "Standard", "Gross", "Sehr Gross"]
				}
			},
			"base_font_size_desktop": {
				"type": "Select",
				"config": {
					"label": " Desktop Basis-Schriftgrösse",
					"placeholder": "",
					"options": ["Sehr Klein", "Klein", "Standard", "Gross", "Sehr Gross"]
				}
			},
			"page_link_color": {
				"type": "Color",
				"config": {
					"label": "Linkfarbe",
					"placeholder": "Hex-Farbcode (#RRGGBB)"
				}
			},
			"page_link_hover_color": {
				"type": "Color",
				"config": {
					"label": "Linkfarbe wenn Maus darüber",
					"placeholder": "Hex-Farbcode (#RRGGBB)"
				}
			},
			"page_button_color": {
				"type": "Color",
				"config": {
					"label": "Schaltflächen-Schriftfarbe",
					"placeholder": "Hex-Farbcode (#RRGGBB)"
				}
			},
			"page_button_bg_color": {
				"type": "Color",
				"config": {
					"label": "Schaltflächen-Hintergrundfarbe",
					"placeholder": "Hex-Farbcode (#RRGGBB)"
				}
			},
			"page_button_hover_color": {
				"type": "Color",
				"config": {
					"label": "Schaltfl. SF wenn Maus drüber",
					"placeholder": "Hex-Farbcode (#RRGGBB)"
				}
			},
			"page_button_hover_bg_color": {
				"type": "Color",
				"config": {
					"label": "Schaltfl. HF wenn Maus drüber",
					"placeholder": "Hex-Farbcode (#RRGGBB)"
				}
			},
			"favicon": {
				"type": "Image",
				"config": {
					"label": "Favicon",
					"constraint": {},
					"thumbnails": []
				}
			}
		},
		"Kopfzeile": {
			"site_title_font_size": {
				"type": "Number",
				"config": {
					"label": "Website-Titel Schriftgrösse",
					"placeholder": "0.5 - 5"
				}
			},
			"site_sub_title_font_size": {
				"type": "Number",
				"config": {
					"label": "Website-Untertitel Schriftgrösse",
					"placeholder": "0.5 - 4"
				}
			},
			"logo": {
				"type": "Image",
				"config": {
					"label": "Logo",
					"constraint": {},
					"thumbnails": []
				}
			},
			"logo_height": {
				"type": "Number",
				"config": {
					"label": "Logo Grösse",
					"placeholder": "1 - 20"
				}
			},
			"header_bg_color": {
				"type": "Color",
				"config": {
					"label": "Hintergrundfarbe",
					"placeholder": "Hex-Farbcode (#RRGGBB)"
				}
			},
			"header_bg_opacity": {
				"type": "Number",
				"config": {
					"label": "Deckkraft der Hintergrundfarbe",
					"placeholder": "in %"
				}
			},
			"header_link_color": {
				"type": "Color",
				"config": {
					"label": "Linkfarbe",
					"placeholder": "Hex-Farbcode (#RRGGBB)"
				}
			},
			"header_link_hover_color": {
				"type": "Color",
				"config": {
					"label": "Linkfarbe, wenn Maus darüber",
					"placeholder": "Hex-Farbcode (#RRGGBB)"
				}
			},
			"header_link_font_size": {
				"type": "Number",
				"config": {
					"label": "Link Schriftgrösse",
					"placeholder": "1.5 - 3"
				}
			},
			"header_link_font": {
				"type": "Link",
				"config": {
					"label": "Link Schriftart",
					"select": "document",
					"repeat": false,
					"customtypes": [
						{
							"id": "font",
							"fields": ["name"]
						}
					]
				}
			}
		},
		"Fusszeile": {
			"footer_bg_color": {
				"type": "Color",
				"config": {
					"label": "Hintergrundfarbe",
					"placeholder": "Hex-Farbcode (#RRGGBB)"
				}
			},
			"footer_color": {
				"type": "Color",
				"config": {
					"label": "Textfarbe",
					"placeholder": "Hex-Farbcode (#RRGGBB)"
				}
			},
			"footer_font_size_top_bar": {
				"type": "Number",
				"config": {
					"label": "Textgrösse Obere Fusszeile",
					"placeholder": "0.5 - 2"
				}
			},
			"footer_font_size_button_bar": {
				"type": "Number",
				"config": {
					"label": "Textgrösse Untere Fusszeile",
					"placeholder": "0.2 - 1.5"
				}
			},
			"footer_link_color": {
				"type": "Color",
				"config": {
					"label": "Link Farbe",
					"placeholder": "Hex-Farbcode (#RRGGBB)"
				}
			},
			"footer_link_hover_color": {
				"type": "Color",
				"config": {
					"label": "Linkfarbe wenn Maus darüber",
					"placeholder": "Hex-Farbcode (#RRGGBB)"
				}
			}
		}
	}
}
