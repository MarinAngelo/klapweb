{
	"format": "custom",
	"id": "variablen",
	"label": "Variablen & Preise",
	"repeatable": false,
	"status": true,
	"json": {
		"Variablen & Preise": {
			"eintraege": {
				"type": "Group",
				"config": {
					"label": "Einträge (Variablen & Preise)",
					"repeat": true,
					"fields": {
						"schluessel": {
							"type": "Text",
							"config": {
								"label": "Schlüssel (Token-Name)",
								"placeholder": "PreisA"
							}
						},
						"wert": {
							"type": "Text",
							"config": {
								"label": "Wert",
								"placeholder": "100.00"
							}
						},
						"waehrung": {
							"type": "Select",
							"config": {
								"label": "Währung des Wertes (für Auto-Umrechnung)",
								"placeholder": "Leer = kein Preis",
								"options": ["CHF", "EUR", "USD", "GBP", "INR", "JPY", "AUD", "CAD"]
							}
						}
					}
				}
			}
		},
		"Zahlungsplan": {
			"zahlungsplan": {
				"type": "Group",
				"config": {
					"label": "Zahlungsplan-Aufteilung (gilt für alle Preise)",
					"repeat": true,
					"fields": {
						"suffix": {
							"type": "Text",
							"config": {
								"label": "Token-Suffix",
								"placeholder": "anz"
							}
						},
						"prozent": {
							"type": "Number",
							"config": {
								"label": "Prozent",
								"placeholder": "30"
							}
						}
					}
				}
			}
		},
		"Währungen": {
			"basis_waehrung": {
				"type": "Select",
				"config": {
					"label": "Basiswährung",
					"placeholder": "",
					"options": ["CHF", "EUR", "USD", "GBP", "INR", "JPY", "AUD", "CAD"],
					"default_value": "CHF"
				}
			},
			"waehrungen": {
				"type": "Group",
				"config": {
					"label": "Angezeigte Umrechnungskurse",
					"repeat": true,
					"fields": {
						"code": {
							"type": "Text",
							"config": {
								"label": "Währungscode (z.B. USD)",
								"placeholder": "USD"
							}
						},
						"nachkommastellen": {
							"type": "Number",
							"config": {
								"label": "Nachkommastellen",
								"placeholder": "4"
							}
						}
					}
				}
			}
		}
	}
}
