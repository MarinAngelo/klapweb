{
	"name": "Klap-Web",
	"version": "1.0.0",
	"private": true,
	"scripts": {
		"dev": "node scripts/build-customtypes.js && concurrently \"npm:vite:dev\" \"npm:slicemachine\" --prefix-colors blue,magenta",
		"vite:dev": "vite dev",
		"build": "node scripts/build-customtypes.js && vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"slicemachine": "start-slicemachine",
		"build-customtypes": "node scripts/build-customtypes.js",
		"clean": "rimraf .svelte-kit",
		"rebuild": "npm run clean && npm run build"
	},
	"devDependencies": {
		"@netlify/functions": "^5.2.0",
		"@slicemachine/adapter-sveltekit": "^0.3.91",
		"@sveltejs/adapter-auto": "^3.2.2",
		"@sveltejs/kit": "^2.5.15",
		"@sveltejs/vite-plugin-svelte": "^3.1.1",
		"@types/dompurify": "^3.0.5",
		"@types/eslint": "^8.56.10",
		"@types/p5": "^1.7.7",
		"autoprefixer": "^10.4.19",
		"concurrently": "^8.2.2",
		"eslint": "^9.5.0",
		"eslint-config-prettier": "^9.1.0",
		"eslint-plugin-svelte": "^2.39.3",
		"globals": "^15.4.0",
		"postcss": "^8.4.38",
		"prettier": "^3.3.2",
		"prettier-plugin-svelte": "^3.2.4",
		"slice-machine-ui": "^2.20.4",
		"svelte": "^4.2.18",
		"svelte-check": "^3.8.0",
		"tailwindcss": "^3.4.4",
		"tslib": "^2.6.3",
		"typescript": "^5.4.5",
		"typescript-eslint": "^8.0.0-alpha.20",
		"typescript-svelte-plugin": "^0.3.38",
		"vite": "^5.3.1"
	},
	"type": "module",
	"dependencies": {
		"@netlify/blobs": "^10.7.1",
		"@prismicio/client": "^7.17.1",
		"@prismicio/helpers": "^2.3.9",
		"@prismicio/svelte": "^1.5.0",
		"@slicemachine/adapter-next": "^0.3.91",
		"clsx": "^2.1.1",
		"dompurify": "^3.3.1",
		"p5": "^2.2.2",
		"pdf-lib": "^1.17.1",
		"resend": "^6.9.2"
	}
}
