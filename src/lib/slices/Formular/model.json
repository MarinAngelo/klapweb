{
	"id": "form",
	"type": "SharedSlice",
	"name": "Formular",
	"description": "Formular",
	"variations": [
		{
			"id": "default",
			"name": "Standard",
			"docURL": "...",
			"version": "initial",
			"description": "Default",
			"imageUrl": "",
			"primary": {
				"form_title": {
					"type": "Text",
					"config": {
						"label": "Formular Titel",
						"placeholder": ""
					}
				},
				"form_instructions": {
					"type": "StructuredText",
					"config": {
						"multi": "paragraph,preformatted,heading3,heading4,heading5,heading6,strong,em,hyperlink,image,embed,list-item,o-list-item,rtl",
						"allowTargetBlank": true,
						"label": "Formular Instruktionen"
					}
				},
				"submitt_button_text": {
					"type": "Text",
					"config": {
						"label": "Senden-Schaltflächen-Text"
					}
				},
				"submitted_title": {
					"type": "Text",
					"config": {
						"label": "Gesendet Titel",
						"placeholder": ""
					}
				},
				"submitted_text": {
					"type": "StructuredText",
					"config": {
						"multi": "paragraph,preformatted,heading1,heading2,heading3,heading4,heading5,heading6,strong,em,hyperlink,image,embed,list-item,o-list-item,rtl",
						"allowTargetBlank": true,
						"label": "Gesendet Text"
					}
				},
				"form_fields": {
					"type": "Group",
					"config": {
						"label": "Formular Felder",
						"repeat": true,
						"fields": {
							"field_name": {
								"type": "Text",
								"config": {
									"label": "Formularfeld Label"
								}
							},
							"field_type": {
								"type": "Select",
								"config": {
									"label": "Feld Typ",
									"placeholder": "",
									"options": [
										"Textfeld",
										"E-Mail",
										"Textbereich",
										"Auswahlliste",
										"Ankreuzfeld",
										"Einzelauswahl"
									]
								}
							},
							"required": {
								"type": "Boolean",
								"config": {
									"placeholder_false": "Nein",
									"placeholder_true": "Ja",
									"default_value": true,
									"label": "Obligatorisch"
								}
							},
							"invalid_feedback_text": {
								"type": "Text",
								"config": {
									"label": "Fehlermeldung",
									"placeholder": "Bitte ausfüllen"
								}
							},
							"options": {
								"type": "Text",
								"config": {
									"label": "Optionen bei Auswahlfeldern",
									"placeholder": "mit Komma getrennt"
								}
							}
						}
					}
				},
				"animate": {
					"type": "Boolean",
					"config": {
						"label": "Animation aktivieren",
						"default_value": false
					}
				},
				"anim_direction": {
					"type": "Select",
					"config": {
						"label": "Animations-Richtung",
						"options": ["Oben", "Unten", "Links", "Rechts", "Keine"],
						"default_value": "Oben"
					}
				},
				"anim_delay": {
					"type": "Number",
					"config": {
						"label": "Verzögerung (ms)",
						"placeholder": "0"
					}
				},
				"anim_duration": {
					"type": "Number",
					"config": { "label": "Animationsdauer (ms)", "placeholder": "2000" }
				}
			},
			"items": {}
		}
	]
}
