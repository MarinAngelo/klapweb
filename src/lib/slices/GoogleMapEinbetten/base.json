{
	"id": "code_einbetten",
	"type": "SharedSlice",
	"name": "GoogleMapEinbetten",
	"description": "CodeEinbetten",
	"variations": [
		{
			"id": "default",
			"name": "Standard",
			"docURL": "...",
			"version": "initial",
			"description": "Default",
			"imageUrl": "",
			"primary": {
				"map_url": {
					"type": "Text",
					"config": {
						"label": "Google Maps URL",
						"placeholder": "Google Maps Link oder Embed-URL (maps.app.goo.gl/... oder google.com/maps/embed?pb=...)"
					}
				},
				"map_height": {
					"type": "Number",
					"config": {
						"label": "Kartenhöhe (px)",
						"placeholder": "400"
					}
				},
				"opacity": {
					"type": "Number",
