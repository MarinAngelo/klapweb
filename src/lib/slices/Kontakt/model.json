{
	"id": "kontakt",
	"type": "SharedSlice",
	"name": "Kontakt",
	"description": "Direkte Kontakt-Buttons für Messenger-Apps",
	"variations": [
		{
			"id": "default",
			"name": "Standard",
			"docURL": "...",
			"version": "sktwi1xtmkfgx8626",
			"description": "Kontakt",
			"primary": {
				"heading": {
					"type": "Text",
					"config": {
						"label": "Überschrift",
						"placeholder": "Kontakt aufnehmen"
					}
				},
				"layout": {
					"type": "Select",
					"config": {
						"label": "Ausrichtung",
						"options": [
							"Horizontal",
							"Vertikal"
						],
						"default_value": "Horizontal"
					}
				},
				"button_size": {
					"type": "Select",
					"config": {
						"label": "Grösse",
						"options": [
							"Klein",
							"Mittel",
							"Gross"
						],
						"default_value": "Mittel"
					}
				},
				"align": {
					"type": "Select",
					"config": {
						"label": "Ausrichtung (horizontal)",
						"options": [
							"Links",
							"Mitte",
							"Rechts"
						],
						"default_value": "Mitte"
					}
				},
				"show_number": {
					"type": "Boolean",
					"config": {
						"label": "Nummer/Adresse anzeigen",
						"placeholder_false": "Nein",
						"placeholder_true": "Ja",
						"default_value": false
					}
				},
				"bg_color": {
					"type": "Color",
					"config": {
						"label": "Hintergrundfarbe",
						"placeholder": "Hex-Farbcode (#RRGGBB)"
					}
				},
				"y_padding": {
					"type": "Select",
					"config": {
						"label": "Vertikaler Abstand",
						"options": [
							"kein Abstand",
							"wenig",
							"mittel",
							"gross"
						]
					}
				},
				"animate": {
					"type": "Boolean",
					"config": {
						"label": "Animation aktivieren",
						"default_value": false
					}
				},
				"anim_direction": {
					"type": "Select",
					"config": {
						"label": "Animations-Richtung",
						"options": [
							"Oben",
							"Unten",
							"Links",
							"Rechts",
							"Keine"
						],
						"default_value": "Oben"
					}
				},
				"anim_delay": {
					"type": "Number",
					"config": {
						"label": "Verzögerung (ms)",
						"placeholder": "500"
					}
				},
				"anim_duration": {
					"type": "Number",
					"config": {
						"label": "Animationsdauer (ms)",
						"placeholder": "2000"
					}
				}
			},
			"items": {
				"app": {
					"type": "Select",
					"config": {
						"label": "App",
						"options": [
							"WhatsApp",
							"Telegram",
							"Signal",
							"Telefon",
							"E-Mail",
							"Facebook Messenger",
							"Instagram"
						],
						"default_value": "WhatsApp"
					}
				},
				"label": {
					"type": "Text",
					"config": {
						"label": "Beschriftung (optional, überschreibt App-Name)",
						"placeholder": ""
					}
				},
				"value": {
					"type": "Text",
					"config": {
						"label": "Nummer / Adresse / Benutzername",
						"placeholder": "+41 79 000 00 00"
					}
				}
			},
			"imageUrl": "https://images.prismic.io/slice-machine/621a5ec4-0387-4bc5-9860-2dd46cbc07cd_default_ss.png?auto=compress,format"
		}
