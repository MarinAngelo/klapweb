{
	"id": "timeline",
	"type": "SharedSlice",
	"name": "Timeline",
	"description": "Vertikale Timeline für CV-Darstellung",
	"variations": [
		{
			"id": "default",
			"name": "Standard",
			"docURL": "...",
			"version": "initial",
			"description": "Standard Timeline",
			"primary": {
				"title": {
					"type": "StructuredText",
					"config": {
						"label": "Titel",
						"placeholder": "z.B. Lebenslauf",
						"single": "heading2"
					}
				},
				"bg_color": {
					"type": "Color",
					"config": {
						"label": "Hintergrundfarbe"
					}
				},
				"color": {
					"type": "Color",
					"config": {
						"label": "Textfarbe"
					}
				},
				"line_color": {
					"type": "Color",
					"config": {
						"label": "Linienfarbe"
					}
				},
				"animate": {
					"type": "Boolean",
					"config": {
						"label": "Einblend-Animation",
						"placeholder_false": "Aus",
						"placeholder_true": "Ein",
						"default_value": true
					}
				}
			},
			"items": {
				"date": {
					"type": "Text",
					"config": {
						"label": "Datum / Jahr",
						"placeholder": "2020 – 2023"
					}
				},
				"title": {
					"type": "Text",
					"config": {
						"label": "Titel",
						"placeholder": "Position oder Ausbildung"
					}
				},
				"subtitle": {
					"type": "Text",
					"config": {
						"label": "Untertitel",
						"placeholder": "Unternehmen oder Institution"
					}
				},
				"description": {
					"type": "StructuredText",
					"config": {
						"label": "Beschreibung",
						"allowTargetBlank": true,
						"multi": "paragraph,strong,em,hyperlink,list-item,o-list-item"
					}
				}
			}
		}
	]
}
